services:
  web:
    image: "{{ api_image }}:{{ image_tag }}"
    container_name: ag-api-web
    restart: unless-stopped
    env_file: {{ compose_root }}/api.env
    ports:
      - "{{ api_listen_port }}:8000"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://127.0.0.1:8000/health/"]
      interval: 30s
      timeout: 10s
      retries: 3
