DJANGO_ENV=production
DEBUG=False
DJANGO_SETTINGS_MODULE={{ django_settings_module }}
PORT=8000
RUN_MIGRATIONS_ON_STARTUP={{ run_migrations_on_startup }}

SECRET_KEY={{ secret_key }}
ALLOWED_HOSTS={{ allowed_hosts }}
# TLS terminates at Cloudflare; app listens HTTP behind tunnel/LB.
SECURE_SSL_REDIRECT=false

DATABASE_URL=postgresql://{{ db_user }}:{{ db_password }}@{{ rds_endpoint }}:5432/{{ db_name }}?sslmode=require

CORS_ALLOWED_ORIGINS={{ cors_allowed_origins }}
FRONTEND_BASE_URL={{ frontend_base_url }}
CSRF_TRUSTED_ORIGINS={{ csrf_trusted_origins }}

CLOUDINARY_CLOUD_NAME={{ cloudinary_cloud_name | default('') }}
CLOUDINARY_API_KEY={{ cloudinary_api_key | default('') }}
CLOUDINARY_API_SECRET={{ cloudinary_api_secret | default('') }}

PESAPAL_CONSUMER_KEY={{ pesapal_consumer_key | default('') }}
PESAPAL_CONSUMER_SECRET={{ pesapal_consumer_secret | default('') }}
PESAPAL_ENVIRONMENT={{ pesapal_environment | default('sandbox') }}
PESAPAL_CALLBACK_URL={{ pesapal_callback_url | default('') }}
PESAPAL_IPN_URL={{ pesapal_ipn_url | default('') }}

GUNICORN_WORKERS={{ api_gunicorn_workers | default(gunicorn_workers) }}

# Observability (Sentry)
SENTRY_DSN={{ sentry_dsn | default('') }}
SENTRY_TRACES_SAMPLE_RATE={{ sentry_traces_sample_rate | default('0') }}
SENTRY_PROFILES_SAMPLE_RATE={{ sentry_profiles_sample_rate | default('0') }}
RELEASE_VERSION={{ release_version | default('unknown') }}

# Supabase (Google OAuth verification)
SUPABASE_URL={{ supabase_url }}
SUPABASE_ANON_KEY={{ supabase_anon_key }}

OTEL_ENABLED=false
