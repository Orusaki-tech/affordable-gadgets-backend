global:
  scrape_interval:     15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets: []

rule_files:
  - 'alerts.yml'

scrape_configs:
  - job_name: 'django'
    scrape_interval: 10s
    metrics_path: /metrics/
    gce_sd_configs:
      - project: {{ gcp_project_id }}
        zone: us-east1-b
        port: 8000
    relabel_configs:
      - source_labels: [__meta_gce_tags]
        regex: ".*,api,.*"
        action: keep
      - source_labels: [__meta_gce_instance_name]
        target_label: instance
      - source_labels: [__meta_gce_zone]
        target_label: zone
      - source_labels: [__address__]
        target_label: service
        replacement: 'django-api'

  - job_name: 'monitoring-vm'
    scrape_interval: 15s
    static_configs:
      - targets: ['localhost:9090']
