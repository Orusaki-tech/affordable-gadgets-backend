global:
  scrape_interval:     15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets: []

rule_files:
  - 'alerts.yml'

scrape_configs:
  - job_name: 'django'
    scrape_interval: 10s
    metrics_path: /metrics/
{% if cloud_provider | default('gcp') == 'aws' %}
    scheme: http
    static_configs:
      - targets: ['{{ prometheus_api_target | default("127.0.0.1:8000") }}']
        labels:
          service: django-api
          environment: {{ deploy_s3_prefix | default(env_name) }}
{% else %}
    scheme: https
    static_configs:
      - targets: ['{{ prometheus_api_target | default(api_public_host) }}']
        labels:
          service: django-api
          instance: production
{% endif %}

  - job_name: 'monitoring-vm'
    scrape_interval: 15s
    static_configs:
      - targets: ['localhost:9090']
