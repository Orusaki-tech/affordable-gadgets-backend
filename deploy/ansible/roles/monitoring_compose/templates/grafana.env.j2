GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password }}

# SMTP for email alerts — set these in the vault
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER={{ grafana_smtp_user | default('') }}
GF_SMTP_PASSWORD={{ grafana_smtp_password | default('') }}
GF_SMTP_FROM_ADDRESS={{ grafana_smtp_from | default('noreply@affordable-gadgetske.com') }}
GF_SMTP_STARTTLS_POLICY=OpportunisticStartTLS
GF_SMTP_SKIP_VERIFY=false
