GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password }}

# Auth for JSON API datasource to reach Django
GF_JSON_API_TOKEN={{ django_admin_token | default('admin') }}

# Image renderer (required in production — default token is rejected by Grafana 13)
GF_RENDERING_RENDERER_TOKEN={{ grafana_rendering_renderer_token | default('ag-grafana-render-prod-token') }}

# SMTP for email alerts — set these in the vault
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER={{ grafana_smtp_user | default('') }}
GF_SMTP_PASSWORD={{ grafana_smtp_password | default('') }}
GF_SMTP_FROM_ADDRESS={{ grafana_smtp_from | default('noreply@affordable-gadgetske.com') }}
GF_SMTP_STARTTLS_POLICY=OpportunisticStartTLS
GF_SMTP_SKIP_VERIFY=false
