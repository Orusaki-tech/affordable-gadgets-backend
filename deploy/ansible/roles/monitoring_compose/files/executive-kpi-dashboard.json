{
  "title": "Affordable Gadgets — Executive KPIs",
  "uid": "ag-exec-kpi",
  "version": 1,
  "tags": ["django", "business", "executive"],
  "timezone": "browser",
  "editable": false,
  "panels": [
    {
      "title": "Revenue MTD",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 3, "h": 4},
      "targets": [{
        "expr": "sum(increase(revenue_total[30d]))",
        "legendFormat": "Revenue"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyKES",
          "color": {"mode": "none"},
          "mappings": [],
          "thresholds": {"steps": [{"color": "green"}]}
        }
      }
    },
    {
      "title": "Orders MTD",
      "type": "stat",
      "gridPos": {"x": 3, "y": 0, "w": 3, "h": 4},
      "targets": [{
        "expr": "sum(increase(orders_total{status=\"Paid\"}[30d]))",
        "legendFormat": "Orders"
      }],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "none"},
          "mappings": [],
          "thresholds": {"steps": [{"color": "green"}]}
        }
      }
    },
    {
      "title": "Avg Order Value",
      "type": "stat",
      "gridPos": {"x": 6, "y": 0, "w": 3, "h": 4},
      "targets": [{
        "expr": "sum(rate(revenue_total[30d])) / sum(rate(orders_total{status=\"Paid\"}[30d]))",
        "legendFormat": "AOV"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyKES",
          "color": {"mode": "none"},
          "mappings": [],
          "thresholds": {"steps": [{"color": "green"}]}
        }
      }
    },
    {
      "title": "Gross Margin",
      "type": "stat",
      "gridPos": {"x": 9, "y": 0, "w": 3, "h": 4},
      "targets": [{
        "expr": "avg(gross_margin_percentage)",
        "legendFormat": "Margin %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {"mode": "none"},
          "mappings": [],
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 10},
              {"color": "green", "value": 20}
            ]
          }
        }
      }
    },
    {
      "title": "Active Users",
      "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 3, "h": 4},
      "targets": [{
        "expr": "active_users",
        "legendFormat": "Active users"
      }],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "none"},
          "mappings": [],
          "thresholds": {"steps": [{"color": "green"}]}
        }
      }
    },
    {
      "title": "Inventory Value",
      "type": "stat",
      "gridPos": {"x": 15, "y": 0, "w": 3, "h": 4},
      "targets": [{
        "expr": "inventory_value{status=\"AV\"}",
        "legendFormat": "Available"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyKES",
          "color": {"mode": "none"},
          "mappings": [],
          "thresholds": {"steps": [{"color": "green"}]}
        }
      }
    },
    {
      "title": "Daily Revenue by Product Type",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [{
        "expr": "sum(increase(revenue_total[1d])) by (product_type)",
        "legendFormat": "{{product_type}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyKES",
          "custom": {"drawStyle": "line", "fillOpacity": 10}
        }
      }
    },
    {
      "title": "Orders by Status (30d)",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [{
        "expr": "sum(increase(orders_total[1d])) by (status)",
        "legendFormat": "{{status}}"
      }],
      "fieldConfig": {
        "defaults": {
          "custom": {"drawStyle": "line", "fillOpacity": 10, "stacking": {"mode": "normal"}}
        }
      }
    },
    {
      "title": "Leads (30d)",
      "type": "stat",
      "gridPos": {"x": 0, "y": 12, "w": 3, "h": 4},
      "targets": [{
        "expr": "sum(increase(leads_total[30d]))",
        "legendFormat": "Leads"
      }]
    },
    {
      "title": "Conversions (30d)",
      "type": "stat",
      "gridPos": {"x": 3, "y": 12, "w": 3, "h": 4},
      "targets": [{
        "expr": "sum(increase(lead_conversion_total[30d]))",
        "legendFormat": "Conversions"
      }]
    },
    {
      "title": "Lead Conversion Rate",
      "type": "stat",
      "gridPos": {"x": 6, "y": 12, "w": 3, "h": 4},
      "targets": [{
        "expr": "sum(rate(lead_conversion_total[30d])) / sum(rate(leads_total[30d])) * 100",
        "legendFormat": "Rate"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 20},
              {"color": "green", "value": 40}
            ]
          }
        }
      }
    },
    {
      "title": "New Customers (30d)",
      "type": "stat",
      "gridPos": {"x": 9, "y": 12, "w": 3, "h": 4},
      "targets": [{
        "expr": "sum(increase(customer_registrations_total[30d]))",
        "legendFormat": "Customers"
      }]
    },
    {
      "title": "Inventory Value by Status",
      "type": "piechart",
      "gridPos": {"x": 0, "y": 16, "w": 8, "h": 8},
      "targets": [{
        "expr": "inventory_value",
        "legendFormat": "{{status}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyKES"
        }
      }
    },
    {
      "title": "On-Time Delivery Rate",
      "type": "gauge",
      "gridPos": {"x": 8, "y": 16, "w": 4, "h": 8},
      "targets": [{
        "expr": "sum(increase(delivery_on_time_total[30d])) / (sum(increase(delivery_on_time_total[30d])) + sum(increase(delivery_late_total[30d]))) * 100",
        "legendFormat": "On-time %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 80},
              {"color": "green", "value": 95}
            ]
          }
        }
      }
    },
    {
      "title": "Sell-Through Rate",
      "type": "bargauge",
      "gridPos": {"x": 12, "y": 16, "w": 6, "h": 8},
      "targets": [{
        "expr": "sell_through_rate",
        "legendFormat": "{{product_type}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 30},
              {"color": "green", "value": 60}
            ]
          }
        }
      }
    },
    {
      "title": "Error Rate (1h)",
      "type": "stat",
      "gridPos": {"x": 0, "y": 24, "w": 3, "h": 4},
      "targets": [{
        "expr": "(sum(rate(http_requests_total{status_code=~\"5..\"}[1h])) / sum(rate(http_requests_total[1h]))) * 100",
        "legendFormat": "Error %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 2}
            ]
          }
        }
      }
    },
    {
      "title": "p95 Latency (5m)",
      "type": "stat",
      "gridPos": {"x": 3, "y": 24, "w": 3, "h": 4},
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
        "legendFormat": "p95"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 0.5},
              {"color": "red", "value": 1.0}
            ]
          }
        }
      }
    },
    {
      "title": "Uptime (30d)",
      "type": "stat",
      "gridPos": {"x": 6, "y": 24, "w": 3, "h": 4},
      "targets": [{
        "expr": "avg(up{job=\"django-api\"}) * 100",
        "legendFormat": "Uptime %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 99},
              {"color": "green", "value": 99.9}
            ]
          }
        }
      }
    }
  ]
}
