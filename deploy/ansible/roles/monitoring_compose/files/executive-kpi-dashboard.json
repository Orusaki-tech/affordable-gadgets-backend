      "targets": [
        {
          "expr": "max(increase(revenue_earned_cumulative[$__range_s])) or vector(0)",
          "legendFormat": "Revenue",
          "instant": true,
          "datasource": {
            "type": "datasource",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyKES",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green"
              }
            ]
