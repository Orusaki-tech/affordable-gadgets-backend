{
  "title": "Affordable Gadgets \u2014 Executive KPIs",
  "uid": "ag-exec-kpi",
  "version": 6,
  "tags": [
    "django",
    "business",
    "executive"
  ],
  "timezone": "browser",
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "period",
        "type": "interval",
        "label": "Time Window",
        "auto": false,
        "options": [
          {
            "text": "1h",
            "value": "1h",
            "selected": false
          },
          {
            "text": "24h",
            "value": "24h",
            "selected": true
          },
          {
            "text": "7d",
            "value": "7d",
            "selected": false
          },
          {
            "text": "30d",
            "value": "30d",
            "selected": false
          }
        ],
        "current": {
          "text": "24h",
          "value": "24h"
        },
        "query": "1h,24h,7d,30d",
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "title": "Revenue (${period})",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "expr": "sum(increase(revenue_earned[$period])) or vector(0)",
          "legendFormat": "Revenue",
          "instant": true,
          "datasource": {
            "type": "datasource",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyKES",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green"
              }
            ]
          },
          "noValue": "0"
        }
      },
      "id": 1,
      "datasource": {
        "type": "datasource",
        "uid": "prometheus"
      }
    },
