      "id": 1,
      "title": "Total Users",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "json-api"
          },
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "/api/inventory/analytics/users/",
          "parser": "backend",
          "url_options": {
            "method": "GET",
            "params": [],
            "headers": []
          },
          "columns": [
            {
              "selector": "total_users",
              "text": "total_users",
              "type": "number"
            }
          ],
          "root_selector": "$"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "blue"
              }
            ]
          },
          "noValue": "0"
        }
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "json-api"
