      "type": "table",
      "gridPos": { "x": 4, "y": 21, "w": 20, "h": 6 },
      "targets": [
        {
          "expr": "sort_desc(round(max(increase(whatsapp_clicks_cumulative[24h])) by (product_name)))",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "datasource": { "type": "datasource", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Clicks" },
            "properties": [
              { "id": "custom.align", "value": "center" },
              { "id": "custom.width", "value": 100 }
            ]
          },
      {
        "matcher": { "id": "byName", "options": "Product" },
        "properties": [
          { "id": "custom.align", "value": "left" }
        ]
      }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": { "product_name": "Product", "Value": "Clicks" }
          }
        }
      ],
      "datasource": { "type": "datasource", "uid": "prometheus" }
    },
    {
