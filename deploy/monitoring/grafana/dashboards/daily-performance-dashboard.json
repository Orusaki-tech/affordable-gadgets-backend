            "steps": [{ "color": "green" }]
          },
          "noValue": "0"
        }
      },
      "datasource": { "type": "datasource", "uid": "prometheus" }
    },
    {
      "id": 20,
      "title": "Uptime (30d)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 18, "w": 4, "h": 3 },
      "targets": [
        {
          "expr": "avg(up{job=\"django\"}) * 100",
          "legendFormat": "Uptime",
          "instant": true,
          "datasource": { "type": "datasource", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 99 },
              { "color": "green", "value": 99.9 }
            ]
          },
          "noValue": "0"
        }
      },
      "datasource": { "type": "datasource", "uid": "prometheus" }
    },
    {
      "id": 21,
      "title": "Error Rate (1h)",
      "type": "stat",
      "gridPos": { "x": 16, "y": 18, "w": 4, "h": 3 },
      "targets": [
        {
          "expr": "(sum(rate(http_requests_total{status_code=~\"5..\"}[1h])) or vector(0)) / sum(rate(http_requests_total[1h])) * 100",
          "legendFormat": "Errors",
          "instant": true,
          "datasource": { "type": "datasource", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "noValue": "0"
        }
      },
      "datasource": { "type": "datasource", "uid": "prometheus" }
    },
    {
      "id": 22,
      "title": "p95 Latency (5m)",
      "type": "stat",
      "gridPos": { "x": 20, "y": 18, "w": 4, "h": 3 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "instant": true,
          "datasource": { "type": "datasource", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          },
          "noValue": "0"
        }
      },
      "datasource": { "type": "datasource", "uid": "prometheus" }
    },
    {
      "id": 23,
      "title": "WhatsApp Clicks",
      "type": "stat",
      "gridPos": { "x": 0, "y": 21, "w": 4, "h": 3 },
      "targets": [
        {
          "expr": "round(sum(max(increase(whatsapp_clicks_cumulative[24h])) by (product_name))) or vector(0)",
          "legendFormat": "Clicks",
          "instant": true,
